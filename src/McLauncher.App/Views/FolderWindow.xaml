<ui:FluentWindow x:Class="McLauncher.App.Views.FolderWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="文件夹"
                 Width="940" Height="660"
                 MinWidth="700" MinHeight="460"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Microsoft YaHei UI, Segoe UI">

    <!--
        为什么不用 ListView + GridView：
        那套控件的表头（GridViewColumnHeader）和行都是系统默认样式，在 Mica 窗口里
        会是白底黑字宋体 + 方角，跟启动器其他地方完全不是一套东西。这里自绘：
        ListBox + ItemTemplate 画行、Grid 手画表头，颜色全部走 WPF-UI 的动态资源，
        深浅色主题都能跟着变。
    -->

    <Window.Resources>

        <!-- 表头文字 -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <!-- 一行的通用文字 -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 行容器：圆角 + 悬停 + 选中，全部自己来 -->
        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="5" Margin="0,1" Background="Transparent"
                                Padding="0,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 快捷跳转的小胶囊按钮 -->
        <Style x:Key="JumpButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" Title="文件夹" />

        <!-- 地址栏 -->
        <Grid Grid.Row="1" Margin="22,12,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Height="32" Padding="12,0" Margin="0,0,8,0"
                       ToolTip="回到上一层"
                       Click="OnUpClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="上一层" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>

            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,0" Height="32">
                <TextBlock x:Name="PathText" VerticalAlignment="Center" FontSize="12"
                           Opacity="0.8" TextTrimming="CharacterEllipsis" />
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <ui:Button Height="32" Padding="11,0" Content="刷新" FontSize="12"
                           ToolTip="重新读一次目录" Click="OnRefreshClick" />
                <ui:Button Height="32" Padding="11,0" Content="资源管理器" FontSize="12"
                           Margin="7,0,0,0" ToolTip="交给系统打开（资源管理器坏了就用下面这个窗口）"
                           Click="OnOpenExternalClick" />
                <ui:Button Height="32" Padding="11,0" Content="复制路径" FontSize="12"
                           Margin="7,0,0,0" Click="OnCopyPathClick" />
            </StackPanel>
        </Grid>

        <!-- 快捷跳转：解决「从实例根进来还得点两层才看到模组」 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="22,10,22,0">
            <TextBlock Text="跳到" FontSize="11" Opacity="0.4" VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <Button x:Name="JumpMods" Style="{StaticResource JumpButton}" Content="模组"
                    Click="OnJumpMods" />
            <Button x:Name="JumpSaves" Style="{StaticResource JumpButton}" Content="存档"
                    Click="OnJumpSaves" />
            <Button x:Name="JumpConfig" Style="{StaticResource JumpButton}" Content="配置"
                    Click="OnJumpConfig" />
            <Button x:Name="JumpResourcePacks" Style="{StaticResource JumpButton}" Content="资源包"
                    Click="OnJumpResourcePacks" />
            <Button x:Name="JumpShaderPacks" Style="{StaticResource JumpButton}" Content="光影"
                    Click="OnJumpShaderPacks" />
            <Button x:Name="JumpLogs" Style="{StaticResource JumpButton}" Content="日志"
                    Click="OnJumpLogs" />

            <!-- 只在当前目录就是 mods 时出现：这里只会显示 jar 文件名，
                 想看中文名和图标得去模组管理 -->
            <Button x:Name="ManageMods" Style="{StaticResource JumpButton}"
                    Content="用模组管理打开" Margin="10,0,0,0"
                    Visibility="Collapsed"
                    Click="OnManageModsClick"
                    ToolTip="看中文名、图标，能启用/禁用、移除" />
        </StackPanel>

        <!-- 表头 -->
        <Grid Grid.Row="3" Margin="26,14,26,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource HeaderText}" Margin="30,0,0,0" />
            <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="2" Text="大小" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="3" Text="修改时间" Style="{StaticResource HeaderText}" />
        </Grid>

        <!-- 文件列表 -->
        <Border Grid.Row="4" Margin="22,0" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" Padding="4,4">
            <ListBox x:Name="FileList"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource RowStyle}"
                     MouseDoubleClick="OnItemDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!--
                                    图标自己画，不用 Segoe MDL2 Assets 字体字符 ——
                                    那套码位在部分机器上缺字形，会渲染成方块（tofu），
                                    比没有图标还丑。Path 是矢量，什么字体都不依赖。
                                -->
                                <Path Width="15" Height="15" Stretch="Uniform"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Margin="6,0,0,0" Opacity="0.7">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <!-- 默认：普通文件（折角矩形） -->
                                            <Setter Property="Data"
                                                    Value="M4,1.5 H9.5 L12.5,4.5 V14 H4 Z" />
                                            <Setter Property="Fill"
                                                    Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                    <!-- 文件夹（带标签的页签形状） -->
                                                    <Setter Property="Data"
                                                            Value="M0.5,3.5 H5.5 L7,5.5 H15 V13.5 H0.5 Z" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsModJar}" Value="True">
                                                    <!-- 模组 jar：方块 + 中间一道，和普通文件区分开 -->
                                                    <Setter Property="Data"
                                                            Value="M4,1.5 H12 V14 H4 Z M5.5,6 H10.5 V7 H5.5 Z" />
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsModJar}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding KindLabel}"
                                       Style="{StaticResource CellText}" Opacity="0.62" />
                            <TextBlock Grid.Column="2" Text="{Binding SizeLabel}"
                                       Style="{StaticResource CellText}" Opacity="0.62" />
                            <TextBlock Grid.Column="3" Text="{Binding ModifiedLabel}"
                                       Style="{StaticResource CellText}" Opacity="0.5" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 空目录提示：叠在列表上面 -->
        <TextBlock x:Name="EmptyHint" Grid.Row="4" HorizontalAlignment="Center"
                   VerticalAlignment="Center" FontSize="12" Opacity="0.4"
                   Visibility="Collapsed" TextAlignment="Center" />

        <!-- 底部 -->
        <Grid Grid.Row="5" Margin="22,10,22,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusText" FontSize="11" Opacity="0.55"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" FontSize="11" Opacity="0.35" VerticalAlignment="Center"
                       Text="双击文件夹进入 · 双击文件交给系统打开" />
        </Grid>
    </Grid>
</ui:FluentWindow>
