<ui:FluentWindow x:Class="McLauncher.App.Views.TextInputWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="输入"
                 Width="440" SizeToContent="Height"
                 MinWidth="360"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" Title="输入" />

        <StackPanel Grid.Row="1" Margin="24,8,24,0">
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10" />
            <TextBox x:Name="InputBox" Height="36" VerticalContentAlignment="Center"
                     KeyDown="OnInputKeyDown" />
            <TextBlock x:Name="HintText" FontSize="12" Opacity="0.55"
                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="24,20,24,20">
            <Button Content="取消" Height="34" Padding="18,0" Margin="0,0,8,0"
                    Click="OnCancelClick" IsCancel="True" />
            <Button Content="确定" Height="34" Padding="18,0" FontWeight="SemiBold"
                    Click="OnOkClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
