<ui:FluentWindow x:Class="McLauncher.App.Views.PreflightWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:mods="clr-namespace:McLauncher.Core.Mods;assembly=McLauncher.Core"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=mods:ModPreflightReport}"
                 Title="启动前检查"
                 Width="780" Height="600"
                 MinWidth="600" MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <!--
        这个窗口一个转换器都没用，全靠 DataTrigger。
        历史教训：Window.Resources 里漏掉 StaticResource 的 key 会在 InitializeComponent
        抛 XamlParseException，而那是运行时炸，编译期看不出来。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="启动前检查" />

        <Grid Grid.Row="1" Margin="28,14,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 摘要 -->
            <StackPanel Grid.Row="0" Margin="0,4,0,16">
                <TextBlock x:Name="HeadlineText" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.62"
                           Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 问题列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Background="#0A000000" Padding="14,12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 徽章：错误红 / 提醒橙 -->
                                        <Border CornerRadius="3" Padding="7,2" Margin="0,0,9,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1AC05621" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Background" Value="#1AC0392B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="提醒" />
                                                        <Setter Property="Foreground" Value="#C05621" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Text" Value="错误" />
                                                                <Setter Property="Foreground" Value="#C0392B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.72"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               LineHeight="19" />

                                    <TextBlock Text="{Binding SourceFile}" FontSize="11"
                                               Opacity="0.4" Margin="0,8,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SourceFile}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SourceFile}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#08000000" Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="FootHint" FontSize="11" Opacity="0.45"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="CancelButton" Content="取消启动"
                               Appearance="Secondary"
                               Height="32" Padding="18,0" FontSize="12"
                               Click="OnCancelClick" />
                    <ui:Button x:Name="ContinueButton" Content="仍然启动"
                               Appearance="Primary"
                               Height="32" Padding="18,0" FontSize="12"
                               Margin="10,0,0,0"
                               Click="OnContinueClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
