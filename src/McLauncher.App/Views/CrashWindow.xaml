<ui:FluentWindow x:Class="McLauncher.App.Views.CrashWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:McLauncher.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:CrashViewModel}"
                 Title="{Binding Title}"
                 Width="920" Height="640"
                 MinWidth="680" MinHeight="440"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <!--
        窗口级资源必须跟内容一起写：之前 IntegrityWindow 漏了 BoolToVis，
        解析到那一行就抛 XamlParseException，整个进程静默退出。
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ExtendsContentIntoTitleBar=True 时必须自己放 TitleBar，否则没有关闭按钮 -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <Grid Grid.Row="1" Margin="28,16,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 摘要：读的哪个文件、什么版本、什么 Java -->
            <StackPanel Grid.Row="0" Margin="0,4,0,14">
                <TextBlock Text="{Binding StatusMessage}" FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.62"
                           Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 结论列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Findings}" Margin="0,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Background="#0A000000" Padding="14,12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- 严重程度徽章 + 标题 -->
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="3" Padding="7,2" VerticalAlignment="Center"
                                                Background="{Binding SeverityBackground}">
                                            <TextBlock Text="{Binding SeverityText}" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding SeverityBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- 为什么 -->
                                    <TextBlock Text="{Binding Explanation}" FontSize="12.5" Opacity="0.85"
                                               Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20" />

                                    <!-- 怎么办 -->
                                    <TextBlock Text="{Binding Advice}" FontSize="12.5" Margin="0,8,0,0"
                                               TextWrapping="Wrap" LineHeight="20" Foreground="#1565C0" />

                                    <!-- 嫌疑模组 -->
                                    <TextBlock Text="{Binding SuspectsText}" FontSize="12" Margin="0,8,0,0"
                                               Opacity="0.75" TextWrapping="Wrap"
                                               Visibility="{Binding HasSuspects, Converter={StaticResource BoolToVis}}" />

                                    <!-- 证据原文 -->
                                    <Border Margin="0,10,0,0" CornerRadius="4" Background="#0D000000"
                                            Padding="10,8"
                                            Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding EvidenceText}" FontFamily="Consolas, 等线"
                                                   FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 操作区 -->
        <Grid Grid.Row="2" Margin="28,12,28,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="提示：报告里带了 Mod File 的，才能精确到具体模组"
                           FontSize="11.5" Opacity="0.5" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding AiButtonText}" Height="36" Padding="16,0"
                        Command="{Binding AnalyzeWithAiCommand}"
                        IsEnabled="{Binding CanAnalyzeWithAi}"
                        ToolTip="把日志和模组列表发给 DeepSeek 再分析一次（会上传日志，单次费用约 ¥0.01 以内）" />
                <Button Content="禁用嫌疑模组" Height="36" Padding="16,0" FontWeight="SemiBold" Margin="10,0,0,0"
                        Command="{Binding DisableSuspectsCommand}"
                        IsEnabled="{Binding HasSuspects}"
                        ToolTip="把结论里指出的模组挪进 mods-disabled（不删除，随时能挪回来），重启游戏生效" />
                <Button Content="打开崩溃报告" Height="36" Padding="16,0" Margin="10,0,0,0"
                        Click="OnOpenReportClick"
                        IsEnabled="{Binding HasReportFile}"
                        ToolTip="用系统默认程序打开 crash-reports 里最新的那个 txt" />
                <Button Content="关闭" Height="36" Padding="20,0" Margin="10,0,0,0"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
