<ui:FluentWindow x:Class="McLauncher.App.Views.IntegrityWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:McLauncher.App.ViewModels"
                 xmlns:core="clr-namespace:McLauncher.Core.Launcher;assembly=McLauncher.Core"
                 xmlns:conv="clr-namespace:McLauncher.App.Converters"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:IntegrityViewModel}"
                 Title="{Binding Title}"
                 Width="880" Height="600"
                 MinWidth="660" MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <!--
        IsHealthy → Visibility 用的转换器。
        之前这个窗口漏了定义，XAML 解析到绑定那一行就抛 XamlParseException，
        InitializeComponent 一炸、主窗口那边又没兜，点「校验文件」就整个进程退出。
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            ExtendsContentIntoTitleBar=True 把整个标题栏交给内容接管，
            不自己放一个 ui:TitleBar 就没有最小化/关闭按钮（之前就漏了，只能 Alt+F4）。
        -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <Grid Grid.Row="1" Margin="28,16,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- 标题 + 按钮 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,6,0,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding VersionName}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="逐个文件核对大小与 sha1，找出下坏、下了一半、被删掉的文件"
                           FontSize="12" Opacity="0.6" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                <Button Content="开始校验" Height="36" Padding="18,0" FontWeight="SemiBold"
                        Command="{Binding CheckCommand}"
                        ToolTip="跑一遍深度校验（读一遍所有文件算 sha1），几个 GB 要几十秒" />
                <Button Content="修复" Height="36" Padding="18,0" Margin="10,0,0,0"
                        Command="{Binding RepairCommand}"
                        IsEnabled="{Binding CanRepair}"
                        ToolTip="删掉损坏的文件，再把缺的重新下载一遍，然后自动复查" />
            </StackPanel>
        </StackPanel>

        <!-- 进度 / 结论 -->
        <Border Grid.Row="1" CornerRadius="6" Background="#0A000000" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding Status}" FontSize="13" TextTrimming="CharacterEllipsis" />
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="5" Margin="0,8,0,0" />
                <TextBlock Text="{Binding CurrentFile}" FontSize="11" Opacity="0.5" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CheckedInfo}" FontSize="11.5" Opacity="0.65" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 问题列表 -->
        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding Issues}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="5" Background="#08000000" Padding="10,7">
                            <StackPanel Orientation="Horizontal">
                                <!-- 类型徽章：颜色按严重程度分 -->
                                <Border CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                        MinWidth="66">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1F8A8A8A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}"
                                                             Value="{x:Static core:IntegrityIssueKind.Missing}">
                                                    <Setter Property="Background" Value="#1FC62828" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}"
                                                             Value="{x:Static core:IntegrityIssueKind.EmptyFile}">
                                                    <Setter Property="Background" Value="#1FC62828" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}"
                                                             Value="{x:Static core:IntegrityIssueKind.WrongSize}">
                                                    <Setter Property="Background" Value="#1FE08A00" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}"
                                                             Value="{x:Static core:IntegrityIssueKind.WrongHash}">
                                                    <Setter Property="Background" Value="#1FE08A00" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}"
                                                             Value="{x:Static core:IntegrityIssueKind.IncompleteDownload}">
                                                    <Setter Property="Background" Value="#1FE08A00" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" Foreground="#CC000000"
                                               Text="{Binding Kind, Converter={x:Static conv:IntegrityKindConverter.Instance}}" />
                                </Border>

                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RelativePath}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" MaxWidth="640" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55"
                                               TextTrimming="CharacterEllipsis" MaxWidth="640" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 没问题时给一句人话 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsHealthy, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="✓ 文件齐全，没有发现损坏" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="#0F7B0F" />
                <TextBlock Text="{Binding CheckedInfo}" FontSize="12" Opacity="0.6"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

            <TextBlock Grid.Row="3" Text="{Binding Summary}" FontSize="12" Opacity="0.7"
                       Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</ui:FluentWindow>
