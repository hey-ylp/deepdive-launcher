<UserControl x:Class="McLauncher.App.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:McLauncher.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="620" d:DesignWidth="960">

    <!--
        启动页的版式（照 PCL 的路子，但用 Fluent 控件）：
        页头一行 → 版本卡片 → 主操作 → 进度 → 日志吃满剩下的高度。
        进来的第一眼只需要回答一件事：要不要启动。
    -->
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 日志：吃剩余空间，但封顶 340。
                 纯 * 的话 800 高的窗口下它一个人占 60% 以上，把上面真正要看的东西压扁；
                 写死高度又会在下方留一大块空白。封顶是两头都能接受的折中。 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：左边页名，右边状态（实时那行字，不是静态说明） -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="启动" Style="{StaticResource PageTitleStyle}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <!--
                    账号入口：头像 + 名字。放页头是因为"现在是谁在玩"和"启动哪个版本"
                    是同一层级的问题，用户开游戏前总要看一眼自己登的是哪个号。
                -->
                <Button Command="{Binding OpenAccountsCommand}" Cursor="Hand"
                        ToolTip="账号：切换、登录微软正版、管理离线账号">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="6,3" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Shell" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="Background"
                                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">
                        <!-- 头像：有图显示图，没图显示首字母 -->
                        <Grid Width="22" Height="22">
                            <Border CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                    Visibility="{Binding CurrentAccountAvatar,
                                                         Converter={StaticResource NullToVis},
                                                         ConverterParameter=inverse}">
                                <TextBlock Text="{Binding CurrentAccountName,
                                                          Converter={StaticResource FirstLetter}}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <Border CornerRadius="4" ClipToBounds="True"
                                    Visibility="{Binding CurrentAccountAvatar,
                                                         Converter={StaticResource NullToVis}}">
                                <Image Source="{Binding CurrentAccountAvatar}" Stretch="UniformToFill" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding CurrentAccountName}" FontSize="11.5"
                                   Margin="7,0,0,0" VerticalAlignment="Center"
                                   MaxWidth="120" TextTrimming="CharacterEllipsis" />

                        <!-- 正版徽章：离线账号不显示 -->
                        <Border CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                Visibility="{Binding CurrentAccountIsMicrosoft,
                                                     Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="正版" FontSize="10"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        </Border>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="10" Margin="10,0" Opacity="0.18"
                           Fill="{DynamicResource TextFillColorPrimaryBrush}" />

                <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                         Fill="{DynamicResource SystemFillColorSuccessBrush}"
                         ToolTip="启动器状态" />
                <TextBlock Text="{Binding VersionsSummary}" FontSize="11" Opacity="0.6" />
            </StackPanel>
        </Grid>

        <!--
            版本卡片：一个实例 = 一套玩法盒子。
            主标题给实例名（用户记得住的名字），副行才是版本号 / 加载器 / 模组数。
        -->
        <Border Grid.Row="1" CornerRadius="10" Padding="14,12" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 版本方块：1.21.4 显示成 1.21，扫一眼就知道是哪一代 -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding CardIconText}" FontSize="11" Opacity="0.6"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CardTitle}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding InstancePathLine}" />

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding CardMcLabel}" FontSize="11" Opacity="0.65" />

                        <Rectangle Width="1" Height="9" Margin="7,0" Opacity="0.25"
                                   Fill="{DynamicResource TextFillColorPrimaryBrush}" />

                        <!-- 加载器徽章：原版版本不显示（CardHasLoader=false 就整块收起来） -->
                        <Border CornerRadius="9" Padding="7,1" Margin="0,0,7,0"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                Visibility="{Binding CardHasLoader, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CardLoaderBadge}" FontSize="11"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        </Border>

                        <!-- 「N 个模组」做成可点的：用户想「看看装了啥」时，
                             这个数字比工具栏里的按钮更容易想到去点 -->
                        <Button Command="{Binding OpenModManagerCommand}" Cursor="Hand"
                                ToolTip="打开模组管理：中文名、图标、启用/禁用、移除">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock x:Name="Label" Text="{Binding CardModLabel}"
                                                           FontSize="11" Opacity="0.45" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Label" Property="Opacity" Value="0.9" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="切换版本" Style="{StaticResource OutlineButton}"
                            Height="28" Padding="12,0" FontSize="12"
                            Click="OnSwitchVersionClick"
                            ToolTip="切换实例 / 游戏版本（也是新建、重命名、删除实例的入口）" />
                    <Button Content="打开目录" Style="{StaticResource OutlineButton}"
                            Height="28" Padding="12,0" FontSize="12"
                            Margin="6,0,0,0"
                            Command="{Binding OpenInstanceFolderCommand}"
                            ToolTip="打开当前实例目录：versions / mods / saves 都在这" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主操作 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Appearance="Primary" Height="44" Padding="26,0" FontSize="14"
                       Command="{Binding LaunchCommand}"
                       ToolTip="直接启动已下载的版本（没下载会提示先下载）">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Play24}"
                                   FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="启动游戏" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>

            <Button Style="{StaticResource OutlineButton}" Height="44" Padding="20,0" FontSize="13"
                    Margin="8,0,0,0"
                    Command="{Binding DownloadCommand}"
                    ToolTip="只下载、不启动。已经下过的会校验补齐，不会重下已有文件">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.ArrowDownload24}"
                                   FontSize="14" Margin="0,0,7,0" />
                    <TextBlock Text="下载" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource OutlineButton}" Height="44" Padding="20,0" FontSize="13"
                    Margin="8,0,0,0"
                    Click="OnOpenContentBrowserClick"
                    ToolTip="从 Modrinth 搜模组 / 整合包 / 光影包 / 资源包。按当前版本的加载器和游戏版本筛选，每条都标出兼容情况">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.PuzzleCube24}"
                                   FontSize="14" Margin="0,0,7,0" />
                    <TextBlock Text="内容下载" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource OutlineButton}" Height="44" Padding="20,0" FontSize="13"
                    Margin="8,0,0,0"
                    Command="{Binding OpenModManagerCommand}"
                    ToolTip="看这个版本装了哪些模组：中文名、图标、启用/禁用、移除">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.List24}"
                                   FontSize="14" Margin="0,0,7,0" />
                    <TextBlock Text="模组管理" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 进度行：左边一句话状态，中间进度条，右边内存 -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="11" Opacity="0.65"
                       MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       ToolTip="{Binding Status}" />

            <!-- 轨道色显式给：默认轨道是半透明的，压在浅灰页底上等于没有 -->
            <ProgressBar Grid.Column="1" Value="{Binding ProgressPercent}" Maximum="100"
                         Height="4" Margin="12,0" VerticalAlignment="Center"
                         Background="#D0D0D0"
                         BorderThickness="0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                           FontSize="11" Opacity="0.55" Margin="0,0,10,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding MemoryGbLabel}" FontSize="11" Opacity="0.45"
                           ToolTip="这个版本启动时分配的堆大小，在设置页改" />
            </StackPanel>
        </Grid>

        <!-- 日志 -->
        <Border Grid.Row="4" Margin="0,12,0,0" MaxHeight="340" VerticalAlignment="Top"
                CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="34" Margin="12,0,10,0">
                    <TextBlock Text="运行日志" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource OutlineButtonSmall}"
                                Click="OnClearLogClick"
                                ToolTip="清掉界面上的日志（磁盘上的 launcher.log 不动）">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Broom24}"
                                               FontSize="11" Margin="0,0,5,0" />
                                <TextBlock Text="清空" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButtonSmall}" Margin="5,0,0,0"
                                Click="OnCopyLogClick"
                                ToolTip="把整段日志复制到剪贴板">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Copy24}"
                                               FontSize="11" Margin="0,0,5,0" />
                                <TextBlock Text="复制" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButtonSmall}" Margin="5,0,0,0"
                                Click="OnOpenLogFileClick"
                                ToolTip="用记事本打开磁盘上的 launcher.log">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.DocumentText24}"
                                               FontSize="11" Margin="0,0,5,0" />
                                <TextBlock Text="打开文件" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBox Grid.Row="1"
                         Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Consolas, Microsoft YaHei UI"
                         FontSize="12"
                         Padding="10,0,10,10"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
