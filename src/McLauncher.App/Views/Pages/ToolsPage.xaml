<UserControl x:Class="McLauncher.App.Views.Pages.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:McLauncher.Core.Launcher;assembly=McLauncher.Core"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="960">

    <UserControl.Resources>
        <Style x:Key="ToolTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,16">
            <TextBlock Text="工具" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="都是针对「当前选中的版本」操作。左上角切到哪个版本，这里就作用于哪个。"
                       Opacity="0.55" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />

            <!-- ── 诊断类 ──
                 统一通栏：原来这里两列、下面几块通栏，同一页混着两种列宽很难看。
                 卡片内改成「左说明 / 右按钮」，通栏的宽度就不会显得空。 -->
            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="7" Background="#C02B2B"
                                    VerticalAlignment="Center">
                                <TextBlock Text="崩" Foreground="White" FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="崩溃分析" Style="{StaticResource ToolTitle}" />
                                <TextBlock Text="游戏崩了读日志，找出原因和嫌疑模组"
                                           Opacity="0.5" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="读崩溃日志，定位原因和嫌疑模组"
                                   Opacity="0.65" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="分析最近一次崩溃" Height="32" Margin="16,0,0,0"
                            VerticalAlignment="Center" Padding="14,0" FontSize="12" FontWeight="SemiBold"
                            Command="{Binding AnalyzeCrashCommand}"
                            ToolTip="当前版本没有崩溃记录时会提示你" />
                </Grid>
            </Border>

            <!-- 文件校验 -->
            <Border Margin="0,10,0,0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="7" Background="#0F7B0F"
                                    VerticalAlignment="Center">
                                <TextBlock Text="校" Foreground="White" FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="文件校验" Style="{StaticResource ToolTitle}" />
                                <TextBlock Text="检查版本文件是否损坏或缺失"
                                           Opacity="0.5" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="算 sha1 核对文件，坏了可以一键重下"
                                   Opacity="0.65" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="校验当前版本" Height="32" Margin="16,0,0,0"
                            VerticalAlignment="Center" Padding="14,0" FontSize="12" FontWeight="SemiBold"
                            Command="{Binding CheckFilesCommand}" />
                </Grid>
            </Border>

            <!-- ── 导入整合包 ── -->
            <Border Margin="0,10,0,0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="7" Background="#4C6EF5"
                                    VerticalAlignment="Center">
                                <TextBlock Text="包" Foreground="White" FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="导入整合包" Style="{StaticResource ToolTitle}" />
                                <TextBlock Text="把一个现成的整合包装成独立实例"
                                           Opacity="0.5" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="支持 mrpack / CurseForge zip；装完新建一个独立实例，不跟现有的混。"
                                   Opacity="0.65" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="选择整合包文件…" Height="32" Margin="16,0,0,0"
                            VerticalAlignment="Center" Padding="14,0" FontSize="12" FontWeight="SemiBold"
                            Command="{Binding ImportModpackCommand}" />
                </Grid>
            </Border>

            <!-- ── 打开目录 ── -->
            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="7" Background="#9C36B5"
                                VerticalAlignment="Center">
                            <TextBlock Text="夹" Foreground="White" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="打开目录" Style="{StaticResource ToolTitle}" />
                            <TextBlock Text="当前版本的各类文件夹，一键直达"
                                       Opacity="0.5" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="版本隔离开启时在 versions\&lt;版本名&gt;\，关掉时在实例根目录。"
                               Opacity="0.65" FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap" />

                    <UniformGrid Columns="5" Margin="0,12,0,0">
                        <Button Content="版本目录" Style="{StaticResource OutlineButton}" Margin="0,0,6,0"
                                Command="{Binding OpenGameFolderCommand}"
                                CommandParameter="{x:Static core:GameFolderKind.Version}" />
                        <Button Content="模组目录" Style="{StaticResource OutlineButton}" Margin="0,0,6,0"
                                Command="{Binding OpenGameFolderCommand}"
                                CommandParameter="{x:Static core:GameFolderKind.Mods}" />
                        <Button Content="存档目录" Style="{StaticResource OutlineButton}" Margin="0,0,6,0"
                                Command="{Binding OpenGameFolderCommand}"
                                CommandParameter="{x:Static core:GameFolderKind.Saves}" />
                        <Button Content="配置目录" Style="{StaticResource OutlineButton}" Margin="0,0,6,0"
                                Command="{Binding OpenGameFolderCommand}"
                                CommandParameter="{x:Static core:GameFolderKind.Config}" />
                        <Button Content="日志目录" Style="{StaticResource OutlineButton}"
                                Command="{Binding OpenGameFolderCommand}"
                                CommandParameter="{x:Static core:GameFolderKind.Logs}"
                                ToolTip="游戏崩了先看这里的 latest.log" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ── 种子查询 ── -->
            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="7" Background="#1A7F6B"
                                VerticalAlignment="Center">
                            <TextBlock Text="种" Foreground="White" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="种子查询" Style="{StaticResource ToolTitle}" />
                            <TextBlock Text="从存档里读出世界种子，一键去 Chunkbase 看地形"
                                       Opacity="0.5" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="直接从存档读，不用进游戏按 F3；游戏开着时可能读不到。"
                               Opacity="0.65" FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="存档" FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox Height="30" FontSize="12"
                                      MaxWidth="380" MinWidth="240" HorizontalAlignment="Left"
                                      ItemsSource="{Binding Saves}"
                                      SelectedItem="{Binding SelectedSave}"
                                      DisplayMemberPath="Display"
                                      ToolTip="当前版本下的所有存档，按最后游玩时间倒序" />

                            <Button Content="刷新" Style="{StaticResource OutlineButton}"
                                    Height="30" Padding="12,0" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding ReloadSavesCommand}"
                                    ToolTip="刚在游戏里建了新世界？点这个重新扫一遍" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding SaveHint}" Opacity="0.5" FontSize="11"
                               Margin="0,6,0,0" TextWrapping="Wrap" />

                    <Rectangle Height="1" Margin="0,12"
                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="种子" FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />

                        <TextBlock Grid.Column="1" Text="{Binding SelectedSeedText}"
                                   FontSize="15" FontFamily="Consolas" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                        <Button Grid.Column="2" Content="复制" Style="{StaticResource OutlineButton}"
                                Height="30" Padding="14,0" FontSize="12" Margin="12,0,0,0"
                                Command="{Binding CopySeedCommand}" />

                        <Button Grid.Column="3" Content="在 Chunkbase 打开" Height="30" Padding="14,0"
                                FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                                Command="{Binding OpenChunkbaseCommand}"
                                ToolTip="用默认浏览器打开种子地图，游戏版本已经带在链接里" />
                    </Grid>

                    <!-- 自动打开失败时才出现：链接摊在这里，随便选随便复制 -->
                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{Binding ShowChunkbaseUrl, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="浏览器没能自己起来。下面的链接可以直接选中复制，粘到地址栏就行："
                                       FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" />
                            <TextBox Text="{Binding LastChunkbaseUrl, Mode=OneWay}"
                                     IsReadOnly="True" Margin="0,6,0,0"
                                     FontFamily="Consolas" FontSize="11.5"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── 模组汉化 ── -->
            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="7" Background="#5B4BE0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="译" Foreground="White" FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="模组汉化" Style="{StaticResource ToolTitle}" />
                                <TextBlock Text="把模组的英文界面翻成中文，打成资源包，不改原 jar"
                                           Opacity="0.5" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="管理模组" Style="{StaticResource OutlineButton}"
                                    Height="30" Padding="14,0" FontSize="12"
                                    Command="{Binding OpenModManagerCommand}"
                                    ToolTip="列出 mods 里的所有内容，可以启用/禁用/移除" />
                            <Button Content="扫描模组" Style="{StaticResource OutlineButton}"
                                    Height="30" Padding="14,0" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding ScanModsCommand}"
                                    ToolTip="扫当前版本的 mods 目录，看看哪些模组还没有中文" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding LocalizeStatus}" Opacity="0.62" FontSize="11.5"
                               Margin="0,10,0,0" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding Mods}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,7"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.55"
                                                       Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="汉化" Height="28" Padding="12,0"
                                                FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Style="{StaticResource OutlineButton}"
                                                IsEnabled="{Binding NeedsWork}"
                                                Command="{Binding DataContext.LocalizeModCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="用 DeepSeek 翻译这个模组，生成资源包；已有中文的条目会跳过" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Opacity="0.42" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="翻不出来不影响游戏和模组本身，最差就是没中文。不想要了：进游戏 → 选项 → 资源包，把对应的包关掉就行。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
