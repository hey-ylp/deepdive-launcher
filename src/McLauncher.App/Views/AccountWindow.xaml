<ui:FluentWindow x:Class="McLauncher.App.Views.AccountWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:McLauncher.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="账号"
                 Width="740" Height="600"
                 MinWidth="620" MinHeight="500"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="账号" />

        <!-- 页头（标题在 TitleBar 上已经有了，这里只说用途） -->
        <TextBlock Grid.Row="1" Margin="26,6,26,0"
                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" LineHeight="19"
                   Text="离线账号只能单机玩；微软正版账号有皮肤、能进正版服务器。选定哪个，启动游戏时就用哪个。" />

        <!-- 账号列表 -->
        <Border Grid.Row="2" Margin="26,14,26,0" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ListBox x:Name="AccountList"
                     ItemsSource="{Binding Accounts}"
                     SelectedItem="{Binding SelectedAccount, Mode=OneWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Shell" CornerRadius="6" Padding="10,9" Margin="0,1"
                                            Background="Transparent">
                                        <Grid>
                                            <!-- 选中标记：左边一道竖条。只换背景色在浅色主题下几乎看不出来 -->
                                            <Rectangle x:Name="Mark" Width="3" RadiusX="1.5" RadiusY="1.5"
                                                       HorizontalAlignment="Left" Margin="-6,1,0,1"
                                                       Visibility="Collapsed"
                                                       Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <ContentPresenter />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Shell" Property="Background"
                                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Shell" Property="Background"
                                                    Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 头像：微软账号有图，离线账号显示首字母 -->
                            <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center">
                                <Border CornerRadius="6"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding Avatar, Converter={StaticResource NullToVis},
                                                             ConverterParameter=inverse}">
                                    <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold"
                                               Opacity="0.55"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <Border CornerRadius="6" ClipToBounds="True"
                                        Visibility="{Binding Avatar, Converter={StaticResource NullToVis}}">
                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- 正版徽章 -->
                                    <Border CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                            Visibility="{Binding IsMicrosoft, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="正版" FontSize="10"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding DetailLabel}" FontSize="11" Opacity="0.5"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 每一行自带一个移除（只对微软账号显示） -->
                            <Button Grid.Column="2" Content="移除"
                                    Style="{StaticResource OutlineButton}"
                                    Height="26" Padding="10,0" FontSize="11"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsMicrosoft, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.RemoveAccountCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="只从列表里删掉，不注销微软账号" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部：client id + 操作 -->
        <StackPanel Grid.Row="3" Margin="26,14,26,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="client id" FontSize="11.5" Opacity="0.55"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <ui:TextBox Grid.Column="1" Height="30" FontSize="11.5"
                            FontFamily="Consolas, Microsoft YaHei UI"
                            Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="留空即可，默认用内置的公共 id"
                            ToolTip="一般不填。留空时用内置的公共 client id 走 v1 授权，能正常登录。" />

                <Button Grid.Column="2" Content="怎么填"
                        Style="{StaticResource OutlineButton}"
                        Height="30" Padding="12,0" FontSize="11.5" Margin="8,0,0,0"
                        Click="OnClientIdHelpClick" />
            </Grid>

            <TextBlock FontSize="11" Opacity="0.42" Margin="0,7,0,0" TextWrapping="Wrap"
                       Text="留空就行。内置的 client id 实测能走通整条登录链，登录一次之后会自动续期，不用再登。" />

            <Grid Margin="0,14,0,0">
                <TextBlock Text="{Binding AccountStatusText}" FontSize="11.5" Opacity="0.6"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="刷新登录"
                            Style="{StaticResource OutlineButton}"
                            Height="32" Padding="14,0" FontSize="12"
                            Command="{Binding RefreshAccountCommand}"
                            IsEnabled="{Binding CurrentAccountIsMicrosoft}"
                            ToolTip="用 refresh token 换一次新令牌（怀疑登录失效时用）" />

                    <!-- 主按钮：唯一需要用户动手的入口 -->
                    <ui:Button Content="登录微软账号"
                               Appearance="Primary"
                               Height="32" Padding="16,0" FontSize="12"
                               Margin="8,0,0,0"
                               Command="{Binding LoginMicrosoftCommand}"
                               IsEnabled="{Binding IsAccountBusy, Converter={StaticResource InverseBool}}"
                               ToolTip="打开浏览器登录微软账号，把跳转后的网址粘回来即可。登录一次，之后自动续期" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
