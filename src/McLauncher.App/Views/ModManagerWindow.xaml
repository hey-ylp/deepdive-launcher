<ui:FluentWindow x:Class="McLauncher.App.Views.ModManagerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:McLauncher.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ModManagerViewModel}"
                 Title="{Binding Title}"
                 Width="900" Height="680"
                 MinWidth="680" MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Microsoft YaHei UI, Segoe UI">

    <!--
        窗口级资源必须写全：StaticResource 找不到 key 是 InitializeComponent 里抛
        XamlParseException，进程会静默退出（这个项目踩过两次）。
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="6" Margin="0,1" Background="Transparent"
                                Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <!-- 工具条 -->
        <Grid Grid.Row="1" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" Height="32" FontSize="12.5"
                        PlaceholderText="搜模组名、ID、作者、文件名…"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox Grid.Column="1" Height="32" FontSize="12" Width="110" Margin="8,0,0,0"
                      ItemsSource="{Binding Filters}"
                      SelectedItem="{Binding SelectedFilter}"
                      DisplayMemberPath="Display"
                      ToolTip="按状态筛选" />

            <ui:Button Grid.Column="2" Height="32" Padding="12,0" FontSize="12" Margin="8,0,0,0"
                       Content="刷新" Command="{Binding ReloadCommand}"
                       ToolTip="重新扫一遍 mods 目录" />

            <ui:Button Grid.Column="3" Height="32" Padding="12,0" FontSize="12" Margin="8,0,0,0"
                       Content="打开文件夹" Click="OnOpenFolderClick" />
        </Grid>

        <!-- 列表 -->
        <Border Grid.Row="2" Margin="24,14,24,0" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" Padding="4">
            <Grid>
                <ListBox x:Name="ModList"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowStyle}"
                         ItemsSource="{Binding Mods}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 图标：读 jar 里的 logo，没有就一个占位方块 -->
                                <Grid Grid.Column="0" Width="46" Height="46" Margin="0,0,12,0"
                                      VerticalAlignment="Center">
                                    <Border CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" />
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" Margin="4">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,40,40" RadiusX="6" RadiusY="6" />
                                        </Image.Clip>
                                    </Image>
                                    <TextBlock Text="?" FontSize="16" Opacity="0.25"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- 名字 / 状态 / 详情 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="320" VerticalAlignment="Center" />

                                        <!-- 有中文名时，原名退成小字跟在后面 -->
                                        <TextBlock Text="{Binding OriginalName}" FontSize="11"
                                                   Opacity="0.4" Margin="7,1,0,0"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ShowOriginalName, Converter={StaticResource BoolToVis}}" />

                                        <TextBlock Text="{Binding VersionLabel}" FontSize="11.5"
                                                   Opacity="0.5" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />

                                        <!-- 状态徽章 -->
                                        <Border CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A107C10" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Background" Value="#1A8A8A8A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                                            <Setter Property="Background" Value="#1AC0392B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateLabel}" FontSize="10.5"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#107C10" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Foreground" Value="#7A7A7A" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                                                <Setter Property="Foreground" Value="#C0392B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding DetailLine}" FontSize="11.5" Opacity="0.55"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock FontSize="10.5" Opacity="0.33" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding FileName, Mode=OneWay}" /><Run Text="　·　" /><Run Text="{Binding LoaderLabel, Mode=OneWay}" /><Run Text="　·　" /><Run Text="{Binding SizeLabel, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- 操作 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                    <ui:Button Height="30" Padding="12,0" FontSize="11.5"
                                               Content="启用/禁用"
                                               IsEnabled="{Binding IsBroken, Converter={StaticResource InverseBool}}"
                                               Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="改文件名后缀，不删文件" />
                                    <ui:Button Height="30" Padding="10,0" FontSize="11.5" Margin="6,0,0,0"
                                               Content="移除" Appearance="Danger"
                                               Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="挪到 mods\.trash 里，可以找回" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding EmptyHint}" FontSize="13" Opacity="0.45"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" LineHeight="22" />
                </StackPanel>

                <!-- 加载中 -->
                <TextBlock Text="正在读模组…" FontSize="13" Opacity="0.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- 底部 -->
        <Grid Grid.Row="3" Margin="24,10,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SummaryText}" FontSize="11.5" Opacity="0.6" />
                <TextBlock Text="{Binding FilterHint}" FontSize="11" Opacity="0.4" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="1" FontSize="11" Opacity="0.32" VerticalAlignment="Center"
                       Text="禁用 = 改后缀名，文件还在；移除 = 挪到 .trash" />
        </Grid>
    </Grid>
</ui:FluentWindow>
