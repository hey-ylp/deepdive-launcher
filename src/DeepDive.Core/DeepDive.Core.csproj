<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <!--
      Installer.Forge 2.0.0 里已经包含了 NeoForge 安装器（命名空间 CmlLib.Core.Installer.NeoForge）。
      另引 CmlLib.Core.Installer.NeoForge 会导致类型 NeoForgeInstaller 二义性（CS0433），
      实测确认过，所以只引这一个包。
    -->
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />

    <!--
      读运行中 Java 进程的命令行（Windows WMI）。用来从官方启动器正在跑的游戏里
      取回登录令牌 —— 新版官方启动器不把令牌写到磁盘上，只在启动游戏时通过命令行传。
    -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      给游戏 JVM 挂的补丁 agent（见 JavaAgentFix.cs）。
      编译产物在 tools\writable-fix\，用 `build-agent.ps1` 重新打包后会自动嵌进来。
    -->
    <EmbeddedResource Include="..\..\tools\writable-fix\writable-fix.jar"
                      LogicalName="DeepDive.Core.writable-fix.jar" />
  </ItemGroup>

</Project>
