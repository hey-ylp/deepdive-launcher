<UserControl x:Class="DeepDive.App.Views.Pages.LianjiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DeepDive.App.ViewModels"
             xmlns:conv="clr-namespace:DeepDive.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="620" d:DesignWidth="960">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,16">
            <TextBlock Text="联机" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="用 EasyTier 组虚拟局域网，朋友输同一个房间码就能一起玩。房主在游戏里点「对局域网开放」，其他人就能在多人游戏里看到房间。"
                       Opacity="0.55" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />

            <!-- ── 未联机：创建 / 加入两个入口 ── -->
            <Grid Margin="0,20,0,0"
                  Visibility="{Binding Session.IsOnline, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 创建房间 -->
                <Border Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource CardStyle}">
                    <!-- 三行网格：标题 / 内容（可撑）/ 按钮贴底。
                         两张卡的按钮都钉在底部，内容多少都不会出现「一边按钮悬空」 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="7" Background="#1B7F3B"
                                    VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Add24}" FontSize="18"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="创建房间" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="你当房主，自动生成房间码和密码" Opacity="0.5" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="创建后会得到一个房间码，把「房间码 + 密码」发给朋友，"
                                       Opacity="0.65" FontSize="11.5" Margin="0,14,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="他们点「加入房间」输入就能连上。"
                                       Opacity="0.65" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" />

                            <!-- 补一条用户真会遇到的事：建网卡要过一次 UAC -->
                            <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                           Text="第一次点会弹一次管理员授权（ Windows 建虚拟网卡需要），同意后就不用再点。" />
                            </Border>
                        </StackPanel>

                        <ui:Button Grid.Row="2" Content="创建房间" Height="34" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Padding="18,0" FontSize="12" FontWeight="SemiBold"
                                Appearance="Primary"
                                Command="{Binding CreateRoomCommand}"
                                IsEnabled="{Binding Session.State, Converter={StaticResource IdleOnly}}" />
                    </Grid>
                </Border>

                <!-- 加入房间 -->
                <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="7" Background="#1B6FBF"
                                    VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.People24}" FontSize="18"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="加入房间" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="输入房主给的房间码和密码" Opacity="0.5" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="房间码" FontSize="11.5" Opacity="0.6" Margin="0,14,0,0" />
                            <ui:TextBox Height="30" Margin="0,6,0,0" FontSize="12"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     Text="{Binding JoinNetworkName, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="比如 MC-7K3F" />

                            <TextBlock Text="密码" FontSize="11.5" Opacity="0.6" Margin="0,10,0,0" />
                            <ui:TextBox Height="30" Margin="0,6,0,0" FontSize="12"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     Text="{Binding JoinNetworkSecret, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="4 位数字" />
                        </StackPanel>

                        <Button Grid.Row="2" Content="加入房间" Height="34" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Padding="18,0" FontSize="12" FontWeight="SemiBold"
                                Command="{Binding JoinRoomCommand}"
                                IsEnabled="{Binding Session.State, Converter={StaticResource IdleOnly}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ── 已联机：状态 + 房间信息 + 节点列表 ── -->
            <StackPanel Margin="0,20,0,0"
                        Visibility="{Binding Session.IsOnline, Converter={StaticResource BoolToVis}}">

                <!-- 状态横幅 -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                Background="#1B7F3B" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                       Text="{Binding Session.StatusText}" />
                            <TextBlock FontSize="11.5" Opacity="0.6" Margin="0,3,0,0"
                                       Text="连接已建立。现在去游戏里点「对局域网开放」，朋友就能搜到你的房间。" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="停止联机" Height="32" Padding="16,0" FontSize="12"
                                VerticalAlignment="Center"
                                Command="{Binding StopRoomCommand}" />
                    </Grid>
                </Border>

                <!-- 房间信息 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="房间码" FontSize="11" Opacity="0.5" />
                            <TextBlock Text="{Binding Session.NetworkName}" FontSize="20" FontWeight="SemiBold"
                                       FontFamily="Consolas, Microsoft YaHei UI" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="密码" FontSize="11" Opacity="0.5" />
                            <TextBlock Text="{Binding Session.NetworkSecret}" FontSize="20" FontWeight="SemiBold"
                                       FontFamily="Consolas, Microsoft YaHei UI" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="你的虚拟 IP" FontSize="11" Opacity="0.5" />
                            <TextBlock Text="{Binding Session.VirtualIp}" FontSize="20" FontWeight="SemiBold"
                                       FontFamily="Consolas, Microsoft YaHei UI" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 节点列表 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="在线玩家" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="列表每 3 秒刷新一次，朋友加入后会出现在这里。" FontSize="11" Opacity="0.5" Margin="0,4,0,10" />

                        <ItemsControl ItemsSource="{Binding Session.Peers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="6"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                    Background="#1B7F3B" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding Hostname}" />
                                                <TextBlock FontSize="11" Opacity="0.55"
                                                           Text="{Binding Ipv4, StringFormat=虚拟 IP：{0}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" FontSize="11" Opacity="0.5"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding LatencyMs, StringFormat={}{0} ms}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 提示 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Background="#0F1B7F3B" BorderBrush="#331B7F3B">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="怎么一起玩" />
                        <TextBlock FontSize="11.5" Opacity="0.65" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="18"
                                   Text="1. 房主在游戏里按 Esc → 点「对局域网开放」→ 记下提示的那个端口&#10;2. 其他人点「多人游戏」，应该能自动搜到你的房间&#10;3. 搜不到就在「添加服务器」里填：你的虚拟 IP + 冒号 + 端口（比如 10.20.30.1:51234）" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 状态文字（失败 / 启动中） -->
            <TextBlock Margin="0,16,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                       Text="{Binding Session.StatusText}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
