<UserControl x:Class="DeepDive.App.Views.Pages.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:core="clr-namespace:DeepDive.Core.Launcher;assembly=DeepDive.Core"
             xmlns:vm="clr-namespace:DeepDive.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="620" d:DesignWidth="960">

    <UserControl.Resources>
        <!--
            操作区按钮：WPF-UI 的按钮默认按内容贴边（2 个字的「下载」会比 4 个字的窄），
            放进 UniformGrid 就显得七长八短。这里统一 Height / 字号 / 强制横向拉伸。
        -->
        <Style x:Key="GridButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- 筛选胶囊：一排单选，选中填实色 -->
        <Style x:Key="ChipStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="13" Padding="12,0"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        版本页：左边一列版本（已装 + 远端清单），右边详情和动作。
        和启动页是同一份数据、同一个「当前版本」—— 在这选中，回启动页就是它。
    -->
    <Grid Margin="22,16,22,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左：版本列表 ================= -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="版本" Style="{StaticResource PageTitleStyle}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionsSummary}" Style="{StaticResource CaptionStyle}"
                               Margin="0,0,10,0" />
                    <Button Content="刷新" Style="{StaticResource OutlineButton}"
                            Height="26" Padding="12,0" FontSize="12"
                            Command="{Binding RefreshVersionsCommand}"
                            ToolTip="重新拉取远端版本清单，并重建本地已装列表" />
                </StackPanel>
            </Grid>

            <!-- 过滤：一个搜索框 + 一个只看已装 -->
            <Grid Grid.Row="1" Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="SearchBox" Grid.Column="0" Height="30" FontSize="12"
                            PlaceholderText="搜版本名，比如 1.21 / neoforge"
                            TextChanged="OnSearchTextChanged" />

                <CheckBox x:Name="InstalledOnlyCheck" Grid.Column="1" Margin="12,0,0,0"
                          Content="只看已装" FontSize="12" VerticalAlignment="Center"
                          Checked="OnInstalledOnlyChanged" Unchecked="OnInstalledOnlyChanged" />
            </Grid>

            <!-- 版本类型：正式版 / 测试版 / 远古版 分开筛（Mojang 清单里叫 release / snapshot / old_*） -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Content="全部" Tag="all" GroupName="Channel" IsChecked="True"
                             Style="{StaticResource ChipStyle}" Checked="OnChannelChecked" />
                <RadioButton Content="正式版" Tag="release" GroupName="Channel"
                             Style="{StaticResource ChipStyle}" Checked="OnChannelChecked" />
                <RadioButton Content="测试版" Tag="snapshot" GroupName="Channel"
                             Style="{StaticResource ChipStyle}" Checked="OnChannelChecked" />
                <RadioButton Content="远古版" Tag="old" GroupName="Channel"
                             Style="{StaticResource ChipStyle}" Checked="OnChannelChecked"
                             ToolTip="old_alpha / old_beta：2010~2011 年那批老版本" />
            </StackPanel>

            <Border Grid.Row="3" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ListBox x:Name="VersionList"
                         ItemsSource="{Binding Versions}"
                         SelectedItem="{Binding SelectedVersion, Mode=OneWay}"
                         SelectionChanged="OnVersionSelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11" Opacity="0.5" />
                                        <TextBlock Text="·" FontSize="11" Opacity="0.25" Margin="6,0" />
                                        <TextBlock Text="{Binding ChannelLabel}" FontSize="11" Opacity="0.5" />
                                        <TextBlock Text="·" FontSize="11" Opacity="0.25" Margin="6,0" />
                                        <TextBlock Text="{Binding TimeLabel}" FontSize="11" Opacity="0.4" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 已装的打一块绿牌，远端的不显示（没装就别假装装上了） -->
                                <Border Grid.Column="1" CornerRadius="9" Padding="7,1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="已装" FontSize="11"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Grid.Row="4" Margin="2,8,0,0" FontSize="11"
                       Opacity="0.45" TextWrapping="Wrap"
                       Text="已装版本排在最前（按安装时间倒序），其余按发布时间倒序。选中哪个，启动页就用哪个。" />
        </Grid>

        <!-- ================= 右：详情 / 操作 / 装加载器 ================= -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 详情 -->
                <Border CornerRadius="10" Padding="14,12" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedVersion.Name, TargetNullValue=没选版本}"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedVersionFolder}" />
                        <TextBlock Text="{Binding SelectedVersionStateLabel}" FontSize="11"
                                   Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <Rectangle Height="1" Margin="0,10"
                                   Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="原版" FontSize="11" Opacity="0.45" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CardMcLabel}" FontSize="11" Opacity="0.8" Margin="0,3" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="加载器" FontSize="11" Opacity="0.45" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersionLoaderLabel}" FontSize="11" Opacity="0.8" Margin="0,3" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="类型" FontSize="11" Opacity="0.45" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVersionTypeLabel}" FontSize="11" Opacity="0.8" Margin="0,3" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="安装于" FontSize="11" Opacity="0.45" Margin="0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVersionInstalledLabel}" FontSize="11" Opacity="0.8" Margin="0,3" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="目录" FontSize="11" Opacity="0.45" Margin="0,3" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedVersionFolder}" FontSize="11" Opacity="0.55" Margin="0,3"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedVersionFolder}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 操作 -->
                <Border CornerRadius="10" Padding="11,10" Margin="0,10,0,0" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <UniformGrid Columns="2">
                        <Button Content="启动游戏" Style="{StaticResource GridButton}"
                                Command="{Binding LaunchCommand}" />
                        <Button Content="下载" Style="{StaticResource GridButton}"
                                Command="{Binding DownloadCommand}"
                                ToolTip="只下载不启动。已下过的会校验补齐，不会重下已有文件" />
                        <Button Content="卸载版本" Style="{StaticResource GridButton}"
                                Command="{Binding UninstallCommand}"
                                ToolTip="删掉这个版本的目录（会先列出会一起没掉的东西给你确认）" />
                        <Button Content="校验文件" Style="{StaticResource GridButton}"
                                Command="{Binding CheckFilesCommand}"
                                ToolTip="逐个算 sha1 检查文件是否损坏/缺失，能一键修复" />
                        <Button Content="版本目录" Style="{StaticResource GridButton}"
                                Command="{Binding OpenGameFolderCommand}"
                                CommandParameter="{x:Static core:GameFolderKind.Version}" />
                        <Button Content="模组目录" Style="{StaticResource GridButton}"
                                Command="{Binding OpenGameFolderCommand}"
                                CommandParameter="{x:Static core:GameFolderKind.Mods}" />
                        <Button Content="存档目录" Style="{StaticResource GridButton}"
                                Command="{Binding OpenGameFolderCommand}"
                                CommandParameter="{x:Static core:GameFolderKind.Saves}" />
                        <Button Content="日志目录" Style="{StaticResource GridButton}"
                                Command="{Binding OpenGameFolderCommand}"
                                CommandParameter="{x:Static core:GameFolderKind.Logs}"
                                ToolTip="游戏崩了先看这里的 latest.log" />
                    </UniformGrid>
                </Border>

                <!-- 装加载器 -->
                <Border CornerRadius="10" Padding="14,12" Margin="0,10,0,0" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="安装模组加载器" FontSize="12" FontWeight="SemiBold" />

                        <TextBlock Text="加载器" FontSize="11" Opacity="0.45" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding LoaderChoices}"
                                  SelectedItem="{Binding SelectedLoaderChoice}"
                                  DisplayMemberPath="Display"
                                  Height="30" FontSize="12" />

                        <Grid Margin="0,8,0,0"
                              Visibility="{Binding IsLoaderSelected, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="装在哪个原版上" FontSize="11" Opacity="0.45" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding LoaderBaseVersions}"
                                          SelectedItem="{Binding SelectedLoaderBaseVersion}"
                                          Height="30" FontSize="12" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="加载器版本" FontSize="11" Opacity="0.45" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding LoaderVersions}"
                                          SelectedItem="{Binding SelectedLoaderVersion}"
                                          DisplayMemberPath="DisplayName"
                                          Height="30" FontSize="12"
                                          ToolTip="标了「推荐」的优先；留空则自动选官方推荐/最新" />
                            </StackPanel>
                        </Grid>

                        <ui:Button Appearance="Primary" Height="34" Margin="0,10,0,0" FontSize="13"
                                   Command="{Binding InstallLoaderCommand}"
                                   Content="{Binding InstallLoaderLabel}"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center" />

                        <TextBlock Margin="0,8,0,0" FontSize="11" Opacity="0.45" TextWrapping="Wrap"
                                   Text="装完会写进一个独立版本（比如 neoforge-26.3.0.99），原版目录不动，随时可以切回去。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
