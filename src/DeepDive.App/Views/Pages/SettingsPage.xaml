<UserControl x:Class="DeepDive.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DeepDive.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="620" d:DesignWidth="960">

    <UserControl.Resources>
        <!-- 设置项：左边标题 + 右边控件，一行一件事 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,16,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                       Opacity="0.45"
                       Text="{Binding SettingsFileName}"
                       ToolTip="{Binding SettingsFilePath}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,16">
            <StackPanel>

                <!-- 账号 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="账号" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="玩家名" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Grid.Column="1" Height="30" FontSize="12"
                                        MinWidth="220" MaxWidth="260" HorizontalAlignment="Left"
                                        Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="离线模式：这个名字就是游戏里的名字。正版登录还没做，联机时别人看到的就是它。" />
                    </StackPanel>
                </Border>

                <!-- 性能 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="性能" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="内存" Style="{StaticResource FieldLabel}" />

                            <Slider Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Minimum="1024" Maximum="{Binding MaxMemoryMb}"
                                    TickFrequency="512" IsSnapToTickEnabled="True"
                                    Value="{Binding MemoryMb}"
                                    ToolTip="{Binding AutoMemoryHint}" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MemoryGbLabel}" FontSize="12"
                                           Width="72" TextAlignment="Right" VerticalAlignment="Center" />

                                <!-- 固定宽度：按钮文字会从「自动 4096」变成「自动 8192」，
                                     不定宽的话它会自己撑宽，把中间 * 列的滑块挤短 —— 拖动时滑块长度看着会跳 -->
                                <Button Content="{Binding AutoMemoryLabel}" Style="{StaticResource OutlineButton}"
                                        Width="98" Height="26" Padding="0"
                                        FontSize="12" Margin="10,0,0,0"
                                        Command="{Binding AutoMemoryCommand}"
                                        ToolTip="{Binding AutoMemoryHint}" />
                            </StackPanel>
                        </Grid>

                        <!-- 具体算法（物理内存四分之一、按模组数上调、封顶）放 ToolTip：
                             摊在界面上是两行密密麻麻的数字，没人会去读 -->
                        <TextBlock Style="{StaticResource FieldHint}" ToolTip="{Binding AutoMemoryHint}">
                            <Run Text="可调范围 " /><Run Text="{Binding MemoryRangeLabel, Mode=OneWay}" />
                        </TextBlock>

                    </StackPanel>
                </Border>

                <!-- 游戏 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="游戏" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="自动中文" Style="{StaticResource FieldLabel}" />
                            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Left"
                                             FontSize="12"
                                             IsChecked="{Binding AutoChineseLanguage}"
                                             Content="启动前把游戏语言设成简体中文" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="只改 options.txt 的 lang；你自己选过别的语言就不覆盖" />

                        <Rectangle Height="1" Margin="0,12" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="启动时全屏" Style="{StaticResource FieldLabel}" />
                            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Left" FontSize="12"
                                             IsChecked="{Binding ForceFullscreen}"
                                             Content="每次启动都强制全屏" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="写进 options.txt；游戏里按 F11 只影响当次" />

                        <Rectangle Height="1" Margin="0,12" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="版本隔离" Style="{StaticResource FieldLabel}" />
                            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Left" FontSize="12"
                                             IsChecked="{Binding IsolateVersionGameDir}"
                                             Content="每个版本用自己的 mods / saves" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="开=模组/存档跟版本走，卸载一起删；关=所有版本共用。切换不搬文件" />

                        <Rectangle Height="1" Margin="0,12" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="启动前检查模组" Style="{StaticResource FieldLabel}" />
                            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Left" FontSize="12"
                                             IsChecked="{Binding ModPreflightEnabled}"
                                             Content="启动前扫一遍 mods，提前发现缺前置" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="查三类必崩：缺前置 / 装了两份 / 加载器不匹配。拦之前会让你选" />

                        <Rectangle Height="1" Margin="0,12" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="模组中文名" Style="{StaticResource FieldLabel}" />
                            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Left" FontSize="12"
                                             IsChecked="{Binding LookupModChineseNames}"
                                             Content="模组管理里显示中文名" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="联网查中文名并缓存；关掉只用内置词表（40+ 个常见模组）" />
                    </StackPanel>
                </Border>

                <!-- 模组汉化 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="模组汉化" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="启用" Style="{StaticResource FieldLabel}" />
                            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Left" FontSize="12"
                                             IsChecked="{Binding AiLocalizationEnabled}"
                                             Content="允许用 DeepSeek 翻译模组的界面文字" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="译文打成资源包，不动原 jar；游戏里可随时关" />

                        <Rectangle Height="1" Margin="0,12" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="API Key" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Grid.Column="1" Height="30" FontSize="12"
                                        PlaceholderText="sk-...（在 platform.deepseek.com 申请）"
                                        Text="{Binding DeepSeekApiKey, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="只写在本机 instances\launcher-settings.json，不会上传到别处" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="按量计费，一个模组几分钱；翻过的有缓存，重翻不花钱" />

                        <Rectangle Height="1" Margin="0,12" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="模型" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Grid.Column="1" Height="30" FontSize="12"
                                        PlaceholderText="{Binding AiModelPlaceholder}"
                                        Text="{Binding AiModelName, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="DeepSeek 的模型名。留空用默认；官方改名后在这里填新的即可，不用等启动器更新" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="报「模型不存在」时来这换新名字" />
                    </StackPanel>
                </Border>

                <!-- 下载 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="下载" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="下载源" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" Height="30" FontSize="12"
                                      Width="220" HorizontalAlignment="Left"
                                      ItemsSource="{Binding SourceOptions}"
                                      SelectedItem="{Binding SelectedSource}"
                                      DisplayMemberPath="Display" />
                            <Button Grid.Column="2" Content="测速" Style="{StaticResource OutlineButton}"
                                    Height="30" Padding="14,0" FontSize="12"
                                    Margin="8,0,0,0" HorizontalAlignment="Left"
                                    Command="{Binding ProbeSourceCommand}"
                                    ToolTip="实际连一下这个源，看看通不通、慢不慢" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}" Text="{Binding SourceNote}" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0"
                                   Text="{Binding SourceProbeText}" />

                        <Rectangle Height="1" Margin="0,12" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="模组搜索源" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" Height="30" FontSize="12"
                                      Width="220" HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding ModrinthSourceOptions}"
                                      SelectedItem="{Binding SelectedModrinthSource}"
                                      DisplayMemberPath="Display" />

                            <!-- 测速：两个源各打一次真实搜索请求，量到响应头为止。
                                 官方源走 Cloudflare，国内时快时慢，光看名字选不出来。 -->
                            <Button Grid.Column="2" Content="测速" Style="{StaticResource OutlineButton}"
                                    Margin="8,0,0,0" Height="30" Padding="14,0" FontSize="12"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    ToolTip="分别测两个源的响应延迟，只测不切"
                                    Command="{Binding TestModrinthSpeedCommand}" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}" Text="{Binding ModrinthSourceNote}" />

                        <!-- 测速结果：没测过时整行不存在，不留空档。
                             Margin 比上面那行说明大一点、透明度高一点，否则两行灰字会糊成一段。 -->
                        <TextBlock Text="{Binding ModrinthSpeedText}" Margin="0,5,0,0" Opacity="0.82">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModrinthSpeedText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Rectangle Height="1" Margin="0,12" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="下载线程" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" Height="30" FontSize="12" MinWidth="120"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding ConcurrencyOptions}"
                                      SelectedItem="{Binding SelectedConcurrency}"
                                      ToolTip="改完下一次下载生效" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}" Text="{Binding ConcurrencyNote}" />
                    </StackPanel>
                </Border>

                <!-- Java -->
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Java" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="当前" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding JavaInUseLabel}" FontSize="12" Opacity="0.8"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding JavaPathLabel}" FontSize="11" Opacity="0.45"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           ToolTip="{Binding JavaPathLabel}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="使用" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" Height="30" FontSize="12" Width="300"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding JavaOptions}"
                                      SelectedItem="{Binding SelectedJava}"
                                      DisplayMemberPath="Display"
                                      ToolTip="选「自动」就按游戏版本挑；自己装过 JDK 可以在这里指定" />
                            <Button Grid.Column="2" Content="浏览…" Style="{StaticResource OutlineButton}"
                                    Height="30" Padding="12,0" Margin="8,0,0,0"
                                    Command="{Binding BrowseJavaCommand}"
                                    ToolTip="手动挑一个 javaw.exe" />
                            <Button Grid.Column="3" Content="重新扫描" Style="{StaticResource OutlineButton}"
                                    Height="30" Padding="12,0" Margin="8,0,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RescanJavaCommand}"
                                    ToolTip="刚装了新 JDK？点一下重新扫，不用重启启动器" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="1.16↓=J8，1.17~1.20.4=J17，1.20.5↑=J21；自动按版本挑，缺了会下载" />

                        <!-- 32 位 Java 压住内存上限时才出现 -->
                        <TextBlock FontSize="11" Opacity="0.85" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="#C05621"
                                   Text="{Binding JavaMemoryHint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding JavaMemoryHint}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- JVM 参数 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="JVM 参数" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="垃圾回收器" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" Height="30" FontSize="12" Width="300"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding GcModeOptions}"
                                      SelectedItem="{Binding SelectedGcMode}"
                                      DisplayMemberPath="Display"
                                      ToolTip="ZGC 停顿比 G1 短，适合大堆整合包；出问题就切回「只用 G1GC」" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}" Text="{Binding GcHint}" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0"
                                   Text="{Binding SelectedGcMode.Note}" />

                        <Rectangle Height="1" Margin="0,12" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="自定义参数" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Grid.Column="1" Height="30" FontSize="12"
                                        PlaceholderText="留空即可。例如 -Dmixin.debug.export=true"
                                        Text="{Binding CustomJvmArgs, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="原样追加在启动命令的最后，不会覆盖上面那些 GC 参数" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="原样追加到命令行末尾，排障用；填错游戏起不来，清空即恢复" />
                    </StackPanel>
                </Border>

                <!-- 目录 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="目录" Style="{StaticResource CardTitle}" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="实例目录" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding InstanceRoot}" FontSize="11"
                                       Opacity="0.6" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding InstanceRoot}" />
                            <Button Grid.Column="2" Content="打开" Style="{StaticResource OutlineButton}"
                                    Height="26" Padding="12,0" FontSize="12"
                                    Margin="8,0,0,0" Command="{Binding OpenInstanceFolderCommand}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="共用库" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding SharedRepository}" FontSize="11"
                                       Opacity="0.6" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SharedRepository}" />
                            <Button Grid.Column="2" Content="打开" Style="{StaticResource OutlineButton}"
                                    Height="26" Padding="12,0" FontSize="12"
                                    Margin="8,0,0,0" Command="{Binding OpenSharedLibraryFolderCommand}"
                                    ToolTip="libraries / assets / runtime，所有实例共用这一份" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="日志" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding LogFilePath}" FontSize="11"
                                       Opacity="0.6" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LogFilePath}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource CardTitle}" />
                        <TextBlock FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                                   Text="DeepDive · WPF / .NET 8 · 界面 WPF-UI 4.3.0 · 版本与下载 CmlLib.Core 4.1.0" />
                        <TextBlock FontSize="11" Opacity="0.35" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Forge 官方依赖下载页广告维持运营。本启动器不自动打开广告页、不代其收费；常用 Forge 的话建议通过官方渠道支持他们。" />
                        <TextBlock FontSize="11" Opacity="0.35" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="联机功能基于 EasyTier（LGPL-3.0），本启动器以独立进程调用它，自身代码不受 LGPL 传染。EasyTier 组件位于安装目录 easytier\ 下，可自行替换。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
