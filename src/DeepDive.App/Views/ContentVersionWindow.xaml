<ui:FluentWindow x:Class="DeepDive.App.Views.ContentVersionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:DeepDive.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ContentVersionViewModel}"
                 Title="下载"
                 Width="900" Height="640"
                 MinWidth="700" MinHeight="460"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 游戏版本标签：横向一排，选中变蓝底，跟内容窗口的类型切换一致 -->
        <Style x:Key="VersionTab" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="5" BorderThickness="1"
                                BorderBrush="#22000000" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#11000000" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E4C6EF5" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C6EF5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="下载" />

        <!-- 项目名：中文大字 + 英文小字 + 装到哪 -->
        <StackPanel Grid.Row="1" Margin="20,6,20,0">
            <WrapPanel>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Bottom" />
                <TextBlock Text="{Binding TitleSub}" FontSize="12" Opacity="0.45"
                           Margin="8,0,0,2" VerticalAlignment="Bottom"
                           Visibility="{Binding HasTitleSub, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>

            <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.6"
                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding TargetFolder}" />
        </StackPanel>

        <!-- 游戏版本标签行：先定版本，下面才按加载器分行 -->
        <StackPanel Grid.Row="2" Margin="20,12,20,4">
            <TextBlock Text="{Binding InstanceLine}" FontSize="11.5" Opacity="0.5" Margin="0,0,0,6" />

            <ListBox ItemsSource="{Binding GameVersions}"
                     SelectedItem="{Binding SelectedGameVersion}"
                     ItemContainerStyle="{StaticResource VersionTab}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MaxHeight="132">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" FontSize="12.5" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- 加载器行 -->
        <Grid Grid.Row="3" Margin="20,4,20,0">
            <ListBox ItemsSource="{Binding Targets}"
                     ItemContainerStyle="{StaticResource TargetItem}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />

                                        <Border Background="{Binding TypeColor}" CornerRadius="3"
                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeLabel}" Foreground="White"
                                                       FontSize="10.5" />
                                        </Border>

                                        <!-- 跟当前实例的加载器一致：能直接装 -->
                                        <Border Background="#1F0F7B0F" CornerRadius="3"
                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsInstanceMatch,
                                                             Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="✓ 匹配当前实例" Foreground="#0F7B0F"
                                                       FontSize="10.5" />
                                        </Border>

                                        <!--
                                            对不上：橙色警告。这里不能只是「没有绿勾」——
                                            用户扫一眼看不出差别，点下去才发现装错了。
                                        -->
                                        <Border Background="#1FC05621" CornerRadius="3"
                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsMismatch,
                                                             Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="⚠ 与当前实例不符" Foreground="#C05621"
                                                       FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>

                                        <Border Background="#1F888888" CornerRadius="3"
                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasDependencies,
                                                             Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding DependencyText}" FontSize="10.5"
                                                       Opacity="0.85" />
                                        </Border>
                                    </WrapPanel>

                                    <!-- 最新版本号 · 日期 · 大小 · 共几个版本 -->
                                    <TextBlock Text="{Binding MetaText}" FontSize="11.5"
                                               Opacity="0.55" Margin="0,4,0,0" />

                                    <TextBlock Text="{Binding StateText}" FontSize="11.5"
                                               Margin="0,4,0,0" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0F7B0F" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StateText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                        <Setter Property="Foreground" Value="#4C6EF5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="1" Content="下载" Height="32" Padding="18,0"
                                        VerticalAlignment="Center" FontWeight="SemiBold"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.DownloadCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        ToolTip="下载该加载器下支持这个游戏版本的最新文件，必需的前置会一起装" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="这个项目没有支持所选游戏版本的文件，换个版本标签看看。"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.5" FontSize="13" TextWrapping="Wrap" MaxWidth="420"
                       TextAlignment="Center"
                       Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- 底部：进度 + 状态 -->
        <Grid Grid.Row="4" Margin="20,10,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="0" Height="4" Minimum="0" Maximum="1"
                         Value="{Binding Progress}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Opacity="0.5"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ProgressText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ErrorText}" Foreground="#C02B2B" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1" Content="取消下载" Height="30" Padding="12,0"
                        VerticalAlignment="Bottom"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
