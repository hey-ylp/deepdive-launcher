<ui:FluentWindow x:Class="DeepDive.App.Views.MicrosoftLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="登录微软账号"
                 Width="580" Height="560"
                 MinWidth="480" MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <!--
        v1 授权码流程：开浏览器 → 用户登录同意 → 跳转后的网址粘回来。
        两块内容（① 开授权页 / ② 粘网址）用 Border 卡片分开，一眼看清要做什么。
        全部用 code-behind 切状态，不引入任何转换器 ——
        Window.Resources 里漏 key 是运行时炸，历史上吃过这个亏。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="登录微软账号" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="30,10,30,0">
            <StackPanel>
                <TextBlock x:Name="StepTitle" FontSize="19" FontWeight="SemiBold"
                           TextWrapping="Wrap" Text="两步完成登录" />

                <TextBlock x:Name="StepHint" FontSize="12" Opacity="0.64" Margin="0,9,0,0"
                           TextWrapping="Wrap" LineHeight="19"
                           Text="第一次登录需要你在浏览器里同意一次，之后登录状态会自动续期，不用再来。" />

                <!-- ① 打开授权页 -->
                <Border CornerRadius="10" Padding="18,14" Margin="0,20,0,0"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <StackPanel>
                        <TextBlock Text="① 打开授权页，用微软账号登录" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock FontSize="11.5" Opacity="0.6" Margin="0,6,0,0" TextWrapping="Wrap"
                                   LineHeight="18"
                                   Text="点下面的按钮会打开浏览器。登录并点「是」同意授权，页面最后会跳到一个空白页。" />

                        <Button x:Name="OpenBrowserButton" Content="打开授权页"
                                Height="32" Padding="18,0" FontSize="12"
                                Margin="0,12,0,0" HorizontalAlignment="Left"
                                Click="OnOpenBrowserClick" />
                    </StackPanel>
                </Border>

                <!-- ② 粘贴跳转后的网址 -->
                <Border CornerRadius="10" Padding="18,14" Margin="0,12,0,0"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <StackPanel>
                        <TextBlock Text="② 把跳转后地址栏里的网址粘贴到这里" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock FontSize="11.5" Opacity="0.6" Margin="0,6,0,0" TextWrapping="Wrap"
                                   LineHeight="18"
                                   Text="网址长这样：https://login.live.com/oauth20_desktop.srf?code=M.C5...  整条复制过来就行。" />

                        <TextBox x:Name="UrlBox" Margin="0,12,0,0" Height="72"
                                 TextWrapping="Wrap" AcceptsReturn="False"
                                 VerticalContentAlignment="Top" Padding="10,8"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                                 TextChanged="OnUrlChanged" />

                        <TextBlock x:Name="ParseHint" FontSize="11" Opacity="0.55" Margin="0,7,0,0"
                                   TextWrapping="Wrap" Text="还没识别到授权码。" />
                    </StackPanel>
                </Border>

                <!-- 结果 / 错误详情 -->
                <Border x:Name="MessagePanel" CornerRadius="8" Padding="14,11" Margin="0,14,0,0"
                        Visibility="Collapsed" Background="#12C0392B">
                    <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap"
                               LineHeight="20" Foreground="#D9534F" Text="" />
                </Border>

                <TextBlock x:Name="StatusText" FontSize="11.5" Opacity="0.5" Margin="0,14,0,0"
                           TextWrapping="Wrap" Text="" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="30,16,30,22">
            <TextBlock x:Name="FooterHint" FontSize="11" Opacity="0.4"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"
                       HorizontalAlignment="Left"
                       Text="登录后游戏用正版身份启动，能进正版服务器。" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SubmitButton" Content="完成登录"
                        Height="32" Padding="18,0" FontSize="12"
                        IsEnabled="False"
                        Click="OnSubmitClick" />

                <Button x:Name="CancelButton" Content="取消"
                        Height="32" Padding="18,0" FontSize="12"
                        Margin="8,0,0,0"
                        Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
