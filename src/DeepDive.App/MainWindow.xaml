<ui:FluentWindow x:Class="DeepDive.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:DeepDive.App.ViewModels"
                 xmlns:pages="clr-namespace:DeepDive.App.Views.Pages"
                 xmlns:ctl="clr-namespace:DeepDive.App.Controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="DeepDive"
                 Width="1180" Height="800"
                 MinWidth="980" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource PageBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <!-- 导航项：整行可点，选中时左侧一条强调色竖条 + 背景高亮 -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                            <Border x:Name="Bar" Width="3" CornerRadius="2"
                                    HorizontalAlignment="Left" Margin="0,9"
                                    Background="Transparent" />
                            <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- 启动时整块内容上浮淡入（200ms），时序由 MainWindow.xaml.cs 控制。
         为什么不用 XAML EventTrigger：实测窗口首帧渲染在 Show() 之后约 250ms，
         而 Loaded 时就开始算动画的时钟，等画面真正出来时动画已经走完了 ——
         等于白做。必须等 ContentRendered（内容真正呈现）再起跳。 -->
    <Grid x:Name="RootShell">
        <Grid.RenderTransform>
            <TranslateTransform Y="8" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            标题栏下面这条线：WPF-UI 的 TitleBar 自己不画下边框。
            没有它，标题栏和内容区就糊成一片，窗口看着没有"分区"。
            描边色和导航竖线、状态栏横线统一，一条线贯穿整个窗口。

            Background 必须显式给：不给的话标题栏是透明的，露出底下的 Mica。
            而 Mica 在窗口获焦/失焦时会切换 active / inactive 两套基调 ——
            表现为「点一下窗口，顶部就变回另一个颜色」，跟下面铺好的浅灰底对不上。
        -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1"
                Background="{DynamicResource PageBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ui:TitleBar Title="DeepDive" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <!-- 底色跟内容区一致：整个窗口统一浅灰底 + 白色卡片。
                 不给的话导航栏透出 Mica，比内容区还亮，看着像导航浮在上面 -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0"
                    Background="{DynamicResource PageBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,12,8,0">

                        <RadioButton x:Name="NavHome" GroupName="Nav" IsChecked="True"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="OnNavChecked" Tag="home">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Play24}"
                                               FontSize="17" Margin="0,0,11,0" />
                                <TextBlock Text="启动" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavVersions" GroupName="Nav"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="OnNavChecked" Tag="versions">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Box24}"
                                               FontSize="17" Margin="0,0,11,0" />
                                <TextBlock Text="版本" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavContent" GroupName="Nav"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="OnNavChecked" Tag="content">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.PuzzleCube24}"
                                               FontSize="17" Margin="0,0,11,0" />
                                <TextBlock Text="内容" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTools" GroupName="Nav"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="OnNavChecked" Tag="tools">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Wrench24}"
                                               FontSize="17" Margin="0,0,11,0" />
                                <TextBlock Text="工具" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavLianji" GroupName="Nav"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="OnNavChecked" Tag="lianji">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.People24}"
                                               FontSize="17" Margin="0,0,11,0" />
                                <TextBlock Text="联机" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings" GroupName="Nav"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="OnNavChecked" Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Settings24}"
                                               FontSize="17" Margin="0,0,11,0" />
                                <TextBlock Text="设置" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>

                    <!--
                        导航底部原本挂两行小字（CmlLib 版本 / .NET / Java）。
                        实测在深色导航条上就是两块糊在一起的灰点，既看不清也不好看。
                        Java 版本挪到设置页去了，这里留空。
                    -->
                </DockPanel>
            </Border>

            <!--
                页面容器：五个页面常驻，只切可见性。切页不重建控件，日志滚动位置也不会丢。
                外面套 MaxWidthPanel：窗口最大化时把内容框在 1300 逻辑像素内并居中，
                否则首页那种「左右贴边」的版式会被拉散，中间空出一大片。

                底色：页面区铺一层 PageBackgroundBrush（浅灰 #EFEFEF），卡片保持纯白。
                不铺的话底色和卡片都是白的，整页看着是平的，只有一圈细边在区分层次。
            -->
            <Border Grid.Column="1" Background="{DynamicResource PageBackgroundBrush}">
                <ctl:MaxWidthPanel MaxContentWidth="1300">
                    <pages:HomePage x:Name="PageHome" />
                    <pages:VersionsPage x:Name="PageVersions" Visibility="Collapsed" />
                    <pages:ContentPage x:Name="PageContent" Visibility="Collapsed" />
                    <pages:ToolsPage x:Name="PageTools" Visibility="Collapsed" />
                    <pages:LianjiPage x:Name="PageLianji" Visibility="Collapsed" />
                    <pages:SettingsPage x:Name="PageSettings" Visibility="Collapsed" />
                </ctl:MaxWidthPanel>
            </Border>
        </Grid>

        <!-- 底部状态栏：不用点进设置就能知道当前实例、内存、物理内存。
             Background 同上：不给就露 Mica，焦点一变颜色就跳。 -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                Background="{DynamicResource PageBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid Margin="18,0" Height="30">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedInstance.Name}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="·" FontSize="11" Opacity="0.25" Margin="8,0" />
                    <TextBlock Text="{Binding MemoryGbLabel}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="·" FontSize="11" Opacity="0.25" Margin="8,0" />
                    <TextBlock Text="{Binding PhysicalMemoryLabel}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="·" FontSize="11" Opacity="0.25" Margin="8,0" />
                    <TextBlock Text="{Binding DiskFreeLabel}" FontSize="11" Opacity="0.6" />
                </StackPanel>

                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="DeepDive" FontSize="11" Opacity="0.3" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
